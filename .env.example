# =============================================================================
# .env.example — CẤU HÌNH TẬP TRUNG TOÀN HỆ THỐNG VSICO ZALO BOT (MONOREPO)
# Bao gồm: Backend (FastAPI) | Frontend (Next.js) | AI Service | ZCA Bridge | Infra
# =============================================================================

# 1. Cấu hình Máy Chủ Backend (Backend Server Settings)
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 2. Kết Nối Cơ Sở Dữ Liệu MySQL 8.4 (Database Settings)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vsico_zalo_bot

# Mật khẩu quản trị cao nhất MySQL (root)
DB_ROOT_PASSWORD=your_mysql_root_password_here

# Tài khoản ứng dụng riêng biệt (KHÔNG ĐƯỢC ĐẶT LÀ 'root')
MYSQL_USER=vsico_user
MYSQL_PASSWORD=your_mysql_app_password_here

# Thông tin kết nối cho Backend / Alembic
DB_USER=vsico_user
DB_PASSWORD=your_mysql_app_password_here
DATABASE_URL=mysql+pymysql://vsico_user:your_mysql_app_password_here@127.0.0.1:3306/vsico_zalo_bot?charset=utf8mb4

# 3. Bảo Mật Webhook Zalo (Zalo Webhook Settings)
ZALO_APP_ID=zca_personal_bot
ZALO_SECRET_KEY=your_zalo_secret_key_here

# 4. Cấu Hình AI & LLM Provider (Gemini / OpenAI Compatible / Ollama)
# Lưu ý: SĐT tài xế tự động được mask trước khi gửi sang LLM bên ngoài.
AI_ENABLED=true
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL_NAME=gemini-3.5-flash
AI_TIMEOUT_SECONDS=10
AI_FALLBACK_CONFIDENCE_THRESHOLD=0.65

# 5. Cấu Hình Cầu Nối Zalo (zca-js Outbound & Realtime Listener Bridge)
ZALO_BRIDGE_URL=http://localhost:3000
AUTO_DISPATCH_OUTBOUND=true
BOT_API_PORT=3000
BACKEND_WEBHOOK_URL=http://localhost:8000/webhook

# 6. Cấu Hình PaddleOCR Tự Host (Local Self-Hosted PaddleOCR)
OCR_ENABLED=true
OCR_PROVIDER=paddleocr
PADDLE_OCR_URL=http://127.0.0.1:8866/predict/ocr_system
OCR_TIMEOUT_SECONDS=15
OCR_LANG=vi

# 7. Cấu Hình Bộ Sinh Khóa Chính Phân Tán (Snowflake ID 64-bit Settings)
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_EPOCH_MS=1704067200000

# 8. Cấu Hình Lưu Trữ Đối Tượng MinIO (S3-Compatible Object Storage)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_BUCKET_NAME=vsico-zalo-files
MINIO_SECURE=false
MINIO_PRESIGNED_EXPIRE_SECONDS=3600

# 9. Cấu Hình Xác Thực & Phân Quyền Web Quản Lý (JWT & RBAC cho ĐHVT / Admin)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 10. Cấu Hình Kết Nối Hệ Thống Trung Tâm TMS (be-tms Integration API)
TMS_BASE_URL=https://tms-api.vsico.com.vn/api
TMS_USERNAME=your_tms_forwarder_username
TMS_PASSWORD=your_tms_forwarder_password
TMS_TIMEOUT_SECONDS=15
TMS_SYNC_ENABLED=false

# 11. Cấu Hình AI Microservice Nội Bộ (ai-service Settings)
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://127.0.0.1:8001
INTERNAL_SECRET=your_internal_zero_trust_secret_here
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_WAREHOUSES=vsico_warehouse_addresses

# 12. Cấu Hình Frontend Dashboard (Next.js 14 App Router)
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3001
