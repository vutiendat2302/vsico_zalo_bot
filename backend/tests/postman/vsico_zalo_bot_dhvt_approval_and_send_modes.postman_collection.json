{
  "info": {
    "_postman_id": "vsico-dhvt-approval-and-send-modes-2026",
    "name": "VSICO Zalo Bot - Kiểm Thử Chế Độ Nhóm, ĐHVT Duyệt & Form Gửi Zalo",
    "description": "Bộ sưu tập Postman kiểm thử toàn trình: 1. Gửi tin nhắn bóc tách 8 trường cốt lõi; 2. Chế độ nhóm Tự động (tu_dong) vs Chờ duyệt (cho_duyet); 3. Thao tác Điều độ viên (ĐHVT) duyệt ca rà soát; 4. Hiển thị Form tin nhắn kết quả gửi vào nhóm Zalo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "group_id",
      "value": "6469608867469758994",
      "type": "string"
    },
    {
      "key": "group_pk",
      "value": "1",
      "type": "string"
    },
    {
      "key": "review_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Cấu hình nhóm: Bật chế độ TỰ ĐỘNG (send_mode = tu_dong)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"send_mode\": \"tu_dong\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/groups/{{group_pk}}/send-mode",
          "host": ["{{base_url}}"],
          "path": ["api", "groups", "{{group_pk}}", "send-mode"]
        }
      }
    },
    {
      "name": "2. Kịch bản 1: Nhóm TỰ ĐỘNG - Gửi tin chuẩn 8 trường (Tự động duyệt và gửi Zalo)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Trạng thái phải là processed (Tự động gửi)', function () {",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    pm.expect(json.processing_status).to.eql('processed');",
              "    pm.expect(json.data.customer_notifications.length).to.be.above(0);",
              "    console.log('FORM GỬI ZALO KHÁCH HÀNG:', json.data.customer_notifications[0].message_text);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"app_id\": \"zca_personal_bot\",\n  \"event_name\": \"user_send_text\",\n  \"group_id\": \"{{group_id}}\",\n  \"sender\": {\n    \"id\": \"driver_haiphong_01\",\n    \"name\": \"Lái xe Vũ Tiến Đạt\"\n  },\n  \"timestamp\": \"1791798030000\",\n  \"message\": {\n    \"msg_id\": \"postman_auto_valid_{{$timestamp}}\",\n    \"text\": \"Lệnh đóng hàng - KH: Logitem - Điểm đóng: Kho Logitem Tân Quang - 8h\\n1 xe: 15C-878.99 / Vũ Tiến Đạt / 0903976359 / VSIU7399796 / 40HC / chì 73957169\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/webhook",
          "host": ["{{base_url}}"],
          "path": ["webhook"]
        }
      }
    },
    {
      "name": "3. Cấu hình nhóm: Chuyển sang CHỜ DUYỆT (send_mode = cho_duyet)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"send_mode\": \"cho_duyet\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/groups/{{group_pk}}/send-mode",
          "host": ["{{base_url}}"],
          "path": ["api", "groups", "{{group_pk}}", "send-mode"]
        }
      }
    },
    {
      "name": "4. Kịch bản 2: Nhóm CHỜ DUYỆT - Tin chuẩn 100% vẫn vào hàng đợi duyệt",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Tin chuẩn vào nhóm chờ duyệt phải có processing_status = needs_review', function () {",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    pm.expect(json.processing_status).to.eql('needs_review');",
              "    pm.expect(json.data.customer_notifications.length).to.eql(0);",
              "    pm.expect(json.data.reply_to_carrier).to.be.null;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"app_id\": \"zca_personal_bot\",\n  \"event_name\": \"user_send_text\",\n  \"group_id\": \"{{group_id}}\",\n  \"sender\": {\n    \"id\": \"driver_nam_02\",\n    \"name\": \"Lái xe Lê Hoàng Nam\"\n  },\n  \"timestamp\": \"1791798040000\",\n  \"message\": {\n    \"msg_id\": \"postman_manual_valid_{{$timestamp}}\",\n    \"text\": \"Lệnh trả hàng - KH: Logitem - Điểm trả: Depot Tân Vũ\\n1 xe: 29C-556.88 / Lê Hoàng Nam / 0988112233 / MSCU5285725 / 20DC / chì 52851122\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/webhook",
          "host": ["{{base_url}}"],
          "path": ["webhook"]
        }
      }
    },
    {
      "name": "5. Kịch bản 2: ĐHVT tra cứu danh sách các ca chờ duyệt (status=pending)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lấy thành công danh sách ca chờ duyệt', function () {",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql('OK');",
              "    if (json.reviews && json.reviews.length > 0) {",
              "        pm.environment.set('review_id', json.reviews[0].id);",
              "        console.log('Gán review_id mới nhất =', json.reviews[0].id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/reviews?status=pending&limit=10",
          "host": ["{{base_url}}"],
          "path": ["api", "reviews"],
          "query": [
            {
              "key": "status",
              "value": "pending"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "6. Kịch bản 2: ĐHVT Phê duyệt ca rà soát (POST /api/reviews/{id}/approve)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Phê duyệt thành công', function () {",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql('APPROVED');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/reviews/{{review_id}}/approve",
          "host": ["{{base_url}}"],
          "path": ["api", "reviews", "{{review_id}}", "approve"]
        }
      }
    },
    {
      "name": "7. Kịch bản 2: Hiển thị Form tin nhắn Zalo kết quả đã gửi (status=da_gui)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lấy thành công tin nhắn đã gửi ra Zalo', function () {",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    pm.expect(json.messages.length).to.be.above(0);",
              "    const outMsg = json.messages[0];",
              "    pm.expect(outMsg.status).to.eql('da_gui');",
              "    console.log('FORM TIN NHẮN ĐÃ GỬI RA ZALO:', outMsg.content);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/outbound/messages?status=da_gui&limit=1",
          "host": ["{{base_url}}"],
          "path": ["api", "outbound", "messages"],
          "query": [
            {
              "key": "status",
              "value": "da_gui"
            },
            {
              "key": "limit",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "name": "8. Kịch bản 3: Nhóm Tự động nhưng thiếu số chì (Cảnh báo nhà xe qua bot reply)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Tin thiếu chì phải cảnh báo nhà xe', function () {",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    pm.expect(json.processing_status).to.eql('needs_review');",
              "    pm.expect(json.data.reply_to_carrier).to.not.be.null;",
              "    console.log('FORM NHẮC LỖI NHÀ XE:', json.data.reply_to_carrier);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"app_id\": \"zca_personal_bot\",\n  \"event_name\": \"user_send_text\",\n  \"group_id\": \"{{group_id}}\",\n  \"sender\": {\n    \"id\": \"driver_an_03\",\n    \"name\": \"Tài xế Trần Văn An\"\n  },\n  \"timestamp\": \"1791798050000\",\n  \"message\": {\n    \"msg_id\": \"postman_missing_seal_{{$timestamp}}\",\n    \"text\": \"Lệnh đóng hàng - KH: Logitem - Điểm đóng: Kho Logitem Tân Quang\\n1 xe: 15C-444.55 / Trần Văn An / 0988654321 / VSIU2621051 / 40HC\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/webhook",
          "host": ["{{base_url}}"],
          "path": ["webhook"]
        }
      }
    }
  ]
}
