  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "groupId",
      "value": "2001000000000000001"
    },
    {
      "key": "userId",
      "value": "1001000000000000001"
    },
    {
      "key": "messageId",
      "value": "test_process_001"
    }
  ],
  "item": [
    {
      "name": "1. Test Khả Năng Xử Lý Tin Nhắn (Processing / Webhook)",
      "description": "Nhập tin nhắn thô và nhận ngay kết quả đã bóc tách thông tin xe, cont, seal, tài xế, SĐT, giờ đến.",
      "item": [
        {
          "name": "01. [Test Xử Lý] Báo xe chuẩn 1 xe (Happy Path)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_id\": \"zca_personal_bot\",\n  \"event_name\": \"user_send_text\",\n  \"group_id\": \"{{groupId}}\",\n  \"sender\": {\n    \"id\": \"{{userId}}\",\n    \"name\": \"Điều hành Hải Long\"\n  },\n  \"timestamp\": \"1791798010000\",\n  \"quote_msg_id\": null,\n  \"message\": {\n    \"msg_id\": \"test_process_001\",\n    \"text\": \"TRẢ HÀNG\\nCont: VSIU7399796\\nSeal: 73957169\\nBiển số: 15C-878.99\\nTài xế: Trần Quốc Bảo\\nSĐT: 0903976359\\nGiờ đến: 08:00 14/10/2026\\nĐiểm trả: Kho Nhựa Long An\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["webhook"]
            }
          }
        },
        {
          "name": "02. [Test Xử Lý] Báo 2 xe trong 1 tin (Dấu gạch chéo /)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_id\": \"zca_personal_bot\",\n  \"event_name\": \"user_send_text\",\n  \"group_id\": \"{{groupId}}\",\n  \"sender\": {\n    \"id\": \"{{userId}}\",\n    \"name\": \"Điều hành Hải Long\"\n  },\n  \"timestamp\": \"1791798020000\",\n  \"quote_msg_id\": null,\n  \"message\": {\n    \"msg_id\": \"test_process_multi_002\",\n    \"text\": \"15C-123.45 / Nguyễn Văn Nam / 0912345678 / VSIU7399796 / Seal 112233 / 09:00\\n15C-678.90 / Lê Văn Hùng / 0987654321 / GAOU6422920 / Seal 445566 / 10:00\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["webhook"]
            }
          }
        },
        {
          "name": "03. [Test Xử Lý] Xe thiếu seal (Phản hồi bổ sung)",
