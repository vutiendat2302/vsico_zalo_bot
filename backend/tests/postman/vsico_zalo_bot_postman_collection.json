{
  "info": {
    "_postman_id": "vsico-zalo-bot-full-collection",
    "name": "VSICO Zalo Bot & Webhook Gateway Full Suite",
    "description": "Bộ sưu tập kiểm thử Postman hoàn chỉnh cho Bot ZCA (Port 3000) và Backend Python (Port 8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Bot ZCA Controls (Port 3000)",
      "description": "Các API điều khiển trực tiếp Bot ZCA: Lấy groupId, userId, lịch sử tin nhắn, gửi tin nhắn và nhận realtime.",
      "item": [
        {
          "name": "01. Kiểm tra trạng thái Bot & WebSocket",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bot_url}}/api/bot/status",
              "host": ["{{bot_url}}"],
              "path": ["api", "bot", "status"]
            }
          }
        },
        {
          "name": "02. Lấy tất cả Group IDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.group_ids && json.group_ids.length > 0) {",
                  "    pm.environment.set('group_id', json.group_ids[0]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bot_url}}/api/bot/groups",
              "host": ["{{bot_url}}"],
              "path": ["api", "bot", "groups"]
            }
          }
        },
        {
          "name": "03. Lấy chi tiết nhóm và thành viên",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bot_url}}/api/bot/groups/{{group_id}}/info",
              "host": ["{{bot_url}}"],
              "path": ["api", "bot", "groups", "{{group_id}}", "info"]
            }
          }
        },
        {
          "name": "04. Lấy tất cả User IDs (Bạn bè)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.user_ids && json.user_ids.length > 0) {",
                  "    pm.environment.set('user_id', json.user_ids[0]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bot_url}}/api/bot/users?count=1000",
              "host": ["{{bot_url}}"],
              "path": ["api", "bot", "users"],
              "query": [
                {
                  "key": "count",
                  "value": "1000"
                }
              ]
            }
          }
        },
        {
          "name": "05. Lấy thông tin chi tiết một User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bot_url}}/api/bot/users/{{user_id}}",
              "host": ["{{bot_url}}"],
              "path": ["api", "bot", "users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "06. Lấy lịch sử tin nhắn trong nhóm",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bot_url}}/api/bot/groups/{{group_id}}/messages?count=50",
              "host": ["{{bot_url}}"],
              "path": ["api", "bot", "groups", "{{group_id}}", "messages"],
              "query": [
                {
                  "key": "count",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "07. Lấy tin nhắn của UserId cụ thể trong GroupId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bot_url}}/api/bot/groups/{{group_id}}/users/{{user_id}}/messages?count=100",
              "host": ["{{bot_url}}"],
              "path": ["api", "bot", "groups", "{{group_id}}", "users", "{{user_id}}", "messages"],
              "query": [
                {
                  "key": "count",
                  "value": "100"
                }
              ]
            }
          }
        },
        {
          "name": "08. Gửi tin nhắn đến UserId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"message\": \"Xin chào! Đây là tin nhắn thử nghiệm từ Postman qua Bot ZCA.\"\n}"
            },
            "url": {
              "raw": "{{bot_url}}/api/bot/send/user",
              "host": ["{{bot_url}}"],
              "path": ["api", "bot", "send", "user"]
            }
          }
        },
        {
          "name": "09. Gửi tin nhắn đến GroupId",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": \"{{group_id}}\",\n  \"message\": \"THÔNG BÁO TỪ HỆ THỐNG:\\nKiểm thử gửi tin nhắn nhóm từ Postman thành công.\"\n}"
            },
            "url": {
              "raw": "{{bot_url}}/api/bot/send/group",
              "host": ["{{bot_url}}"],
              "path": ["api", "bot", "send", "group"]
            }
          }
        },
        {
          "name": "10. Lấy tin nhắn Realtime mới nhất",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bot_url}}/api/bot/realtime/messages?limit=20",
              "host": ["{{bot_url}}"],
              "path": ["api", "bot", "realtime", "messages"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Webhook Gateway & Backend Python (Port 8000)",
      "description": "Các kịch bản kiểm thử cổng Webhook tiếp nhận tin từ Bot ZCA và lưu trữ MySQL.",
