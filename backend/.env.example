# 1. Cấu hình máy chủ ứng dụng (Server Settings)
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 2. Kết nối cơ sở dữ liệu MySQL 8.4 (Database Settings)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=vsico_zalo_bot
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@127.0.0.1:3306/vsico_zalo_bot?charset=utf8mb4

# 3. Bảo mật Webhook Zalo (Zalo Webhook Settings)
ZALO_APP_ID=zca_personal_bot
ZALO_SECRET_KEY=

# 4. Cấu hình AI Fallback Chung (Configurable Multi-Provider AI Settings)
# Chỉ kích hoạt khi Rule-based Parser không nhận diện được cấu trúc F1/F2/F3
# và độ tin cậy thấp hơn AI_FALLBACK_CONFIDENCE_THRESHOLD.
# Lưu ý: SĐT sẽ tự động được che thành dạng 0931xxxx73 khi gửi sang AI.
AI_ENABLED=true
# Hỗ trợ: gemini, openai_compatible (OpenAI, DeepSeek, Groq, vLLM, Ollama), anthropic
AI_PROVIDER=gemini
# Ví dụ Gemini Native: https://generativelanguage.googleapis.com/v1beta
# Ví dụ OpenAI: https://api.openai.com/v1
# Ví dụ Ollama local: http://127.0.0.1:11434/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL_NAME=gemini-3.5-flash
AI_TIMEOUT_SECONDS=10
AI_FALLBACK_CONFIDENCE_THRESHOLD=0.65

# 5. Cấu hình Cầu Nối Gửi Zalo Ra Ngoài (ZCA Outbound Bridge)
ZALO_BRIDGE_URL=http://localhost:3000
AUTO_DISPATCH_OUTBOUND=true

# 6. Cấu hình PaddleOCR Tự Host (Local Self-Hosted PaddleOCR)
# Bóc tách văn bản từ ảnh điều xe / lệnh đóng trả do tài xế gửi qua Zalo
OCR_ENABLED=true
OCR_PROVIDER=paddleocr
PADDLE_OCR_URL=http://127.0.0.1:8866/predict/ocr_system
OCR_TIMEOUT_SECONDS=15
OCR_LANG=vi
