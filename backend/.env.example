# Cấu hình môi trường ứng dụng
APP_ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=DEBUG

# Cấu hình Zalo OA (khi cắm production thật)
ZALO_APP_ID=1234567890123456789
ZALO_SECRET_KEY=your_zalo_secret_key
ZALO_ACCESS_TOKEN=your_zalo_access_token

# Cấu hình LLM nội bộ (Fallback tùy chọn)
USE_LLM=false
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=20

# Đường dẫn dữ liệu
SHIPPING_FILE_PATH=tests/fixtures/shipping/nhaxe_shipping_demo.csv
MESSAGES_FILE_PATH=tests/fixtures/messages/nhaxe_messages_demo.txt
OUTPUT_RESULTS_PATH=output/results.csv
