# =============================================================================
# .gitignore — HỆ THỐNG VSICO ZALO BOT & TMS INTEGRATION (MONOREPO)
# Phạm vi: backend/ | frontend/ | ai-service/ | database/ | zca-js/ | docs/
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BẢO MẬT, BIẾN MÔI TRƯỜNG & PHIÊN ĐĂNG NHẬP ZALO
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# Phiên đăng nhập Zalo (zca-js) — Tuyệt đối không commit cookie/token/QR
credentials.json
cookies.json
session.json
tokens.json
qr.png
qr_*.png
zca_session/

# Khóa bảo mật & chứng chỉ
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# -----------------------------------------------------------------------------
# 2. PYTHON (BACKEND & AI-SERVICE)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Môi trường ảo
.venv/
venv/
env/
ENV/

# Đóng gói & Build
build/
dist/
*.egg-info/
*.egg
.eggs/

# Kiểm thử, Coverage & Linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# -----------------------------------------------------------------------------
# 3. AI, OCR MODELS & VECTOR DB DATA (AI-SERVICE)
# -----------------------------------------------------------------------------
# Trọng số model tải tự động (PaddleOCR, HuggingFace, ONNX)
.paddleocr/
.cache/
*.onnx
*.pdmodel
*.pdiparams
*.pdiparams.info
*.bin
*.safetensors
*.pt
*.pth

# Dữ liệu cục bộ Qdrant / MinIO / MySQL (nếu mount thư mục local)
qdrant_storage/
minio_data/
mysql_data/

# -----------------------------------------------------------------------------
# 4. FRONTEND (NEXT.JS 14, TYPESCRIPT, PLAYWRIGHT) & NODE.JS (ZCA-JS)
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/cache/
.yarn/unplugged/
.pnpm-store/

# Next.js build & TypeScript incremental build
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Kiểm thử E2E Playwright & Coverage Frontend
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Nhật ký lỗi trình quản lý gói
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -----------------------------------------------------------------------------
# 5. NHẬT KÝ RUNTIME, KẾT QUẢ TẠM & FILE KHÓA VĂN PHÒNG
# -----------------------------------------------------------------------------
*.log
logs/
backend/output/

# Cơ sở dữ liệu tạm
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal

# File tạm & Sao lưu
*.tmp
*.temp
*.bak

# File khóa tạm của Microsoft Office / LibreOffice (Giữ nguyên file gốc .docx, .xlsx, .pdf)
~$*.xlsx
~$*.docx
~$*.pptx
.~lock.*#

# -----------------------------------------------------------------------------
# 6. IDE, TRÌNH SOẠN THẢO & HỆ ĐIỀU HÀNH
# -----------------------------------------------------------------------------
.vscode/
!.vscode/settings.json.example
.idea/
*.iml
.continue/
*.swp
*.swo
*~

# macOS / Windows / Linux
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
.fuse_hidden*
.directory
.Trash-*
